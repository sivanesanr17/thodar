# Copy values into the relevant local environment file. Never commit secrets.
# Free hosted development option. Keep this key private and backend-only.
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional providers: azure or ollama
TRANSLATION_API_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATION_API_URL=http://localhost:11434
TRANSLATION_MODEL=qwen3:4b
MAX_FILE_SIZE_MB=10
MAX_PAGES=20
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional browser origins, such as a Vercel domain.
FRONTEND_URLS=
LOG_LEVEL=INFO
OCR_PROVIDER=tesseract
TESSERACT_CMD=tesseract
OCR_MIN_CONFIDENCE=40
# Optional path to a Tesseract tessdata folder when it is not on the default path.
TESSDATA_PREFIX=
